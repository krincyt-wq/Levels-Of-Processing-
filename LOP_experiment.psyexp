  <Flow>
    <Routine name="instructions_study"/>
    <LoopInitiator loopType="TrialHandler" name="practice">
      <Param name="Selected rows" updates="None" val="" valType="code"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('word', 'spoon'), ('question', 'Is it a living thing?  (Y = yes, N = no)'), ('condition', 'practice'), ('correct_key', 'n')]), OrderedDict([('word', 'snake'), ('question', 'Does it contain the letter E?  (Y = yes, N = no)'), ('condition', 'practice'), ('correct_key', 'y')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="practice_short.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="practice" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Study"/>
    <LoopTerminator name="practice"/>
    <Routine name="begin_main"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="code"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('word', 'sheep'), ('question', 'Is it a living thing?  (Y = yes, N = no)'), ('condition', 'deep'), ('correct_key', 'y')]), OrderedDict([('word', 'spider'), ('question', 'Is it a living thing?  (Y = yes, N = no)'), ('condition', 'deep'), ('correct_key', 'y')]), OrderedDict([('word', 'frog'), ('question', 'Is it a living thing?  (Y = yes, N = no)'), ('condition', 'deep'), ('correct_key', 'y')]), OrderedDict([('word', 'duck'), ('question', 'Is it a living thing?  (Y = yes, N = no)'), ('condition', 'deep'), ('correct_key', 'y')]), OrderedDict([('word', 'bucket'), ('question', 'Is it a living thing?  (Y = yes, N = no)'), ('condition', 'deep'), ('correct_key', 'n')]), OrderedDict([('word', 'candle'), ('question', 'Is it a living thing?  (Y = yes, N = no)'), ('condition', 'deep'), ('correct_key', 'n')]), OrderedDict([('word', 'bowl'), ('question', 'Is it a living thing?  (Y = yes, N = no)'), ('condition', 'deep'), ('correct_key', 'n')]), OrderedDict([('word', 'coin'), ('question', 'Is it a living thing?  (Y = yes, N = no)'), ('condition', 'deep'), ('correct_key', 'n')]), OrderedDict([('word', 'horse'), ('question', 'Does it contain the letter E?  (Y = yes, N = no)'), ('condition', 'shallow'), ('correct_key', 'y')]), OrderedDict([('word', 'eagle'), ('question', 'Does it contain the letter E?  (Y = yes, N = no)'), ('condition', 'shallow'), ('correct_key', 'y')]), OrderedDict([('word', 'lion'), ('question', 'Does it contain the letter E?  (Y = yes, N = no)'), ('condition', 'shallow'), ('correct_key', 'n')]), OrderedDict([('word', 'goat'), ('question', 'Does it contain the letter E?  (Y = yes, N = no)'), ('condition', 'shallow'), ('correct_key', 'n')]), OrderedDict([('word', 'table'), ('question', 'Does it contain the letter E?  (Y = yes, N = no)'), ('condition', 'shallow'), ('correct_key', 'y')]), OrderedDict([('word', 'pencil'), ('question', 'Does it contain the letter E?  (Y = yes, N = no)'), ('condition', 'shallow'), ('correct_key', 'y')]), OrderedDict([('word', 'lamp'), ('question', 'Does it contain the letter E?  (Y = yes, N = no)'), ('condition', 'shallow'), ('correct_key', 'n')]), OrderedDict([('word', 'drum'), ('question', 'Does it contain the letter E?  (Y = yes, N = no)'), ('condition', 'shallow'), ('correct_key', 'n')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="study_listB_short.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Study"/>
    <LoopTerminator name="trials"/>
    <Routine name="distractor"/>
    <Routine name="instructions_recall"/>
    <Routine name="recall"/>
    <Routine name="thanks"/>
  </Flow>
